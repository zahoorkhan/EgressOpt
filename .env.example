# COPY to .env on your machine; never upload .env.
# Use locally authenticated CLI sessions instead of static access keys.
# Set these before cloud execution (export them in your shell).
EGRESSOPT_AWS_PROFILE=your-sso-profile
EGRESSOPT_AWS_REGION=us-east-1
EGRESSOPT_AWS_INSTANCE_ID=your-aws-ec2-instance-id
EGRESSOPT_AWS_INSTANCE=your-aws-ec2-instance-id
EGRESSOPT_AZURE_RESOURCE_GROUP=your-resource-group
EGRESSOPT_AZURE_VM=your-azure-vm-name
EGRESSOPT_AZURE_NSG=your-azure-network-security-group
EGRESSOPT_AZURE_PUBLIC_IP_RESOURCE=your-azure-public-ip-resource-name
EGRESSOPT_GCP_PROJECT=your-gcp-project-id
EGRESSOPT_GCP_ZONE=us-east4-a
EGRESSOPT_GCP_VM=your-gcp-vm-name
# Access tokens for ephemeral workers must be generated per run, never stored here.
